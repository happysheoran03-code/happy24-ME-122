# Step 6: Encryption
message = input("\nEnter message (uppercase letters only): ").upper()

if not message.isalpha():
    print("Please enter letters only.")
else:
    encrypted = []

    for char in message:
        m = ord(char) - ord('A')
        c = pow(m, e, n)
        encrypted.append(c)

    print("\nEncrypted Message:", encrypted)

    # Step 7: Decryption
    decrypted = ""

    for c in encrypted:
