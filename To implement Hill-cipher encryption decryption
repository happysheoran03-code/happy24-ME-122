
import math

def mod_inverse(a, m):
    for i in range(1, m):
        if (a * i) % m == 1:
            return i
    return None


def matrix_inverse(key):
    a, b = key[0]
    c, d = key[1]

    det = (a * d - b * c) % 26
    inv_det = mod_inverse(det, 26)

    if inv_det is None:
        raise ValueError("Key matrix is not invertible modulo 26.")

    return [
        [(d * inv_det) % 26, (-b * inv_det) % 26],
        [(-c * inv_det) % 26, (a * inv_det) % 26]
    ]


def prepare_text(text):
    text = ''.join(ch.upper() for ch in text if ch.isalpha())
    if len(text) % 2 != 0:
        text += 'X'
    return text


def hill_cipher(text, key):
    text = prepare_text(text)
    result = ""

    for i in range(0, len(text), 2):
        x = ord(text[i]) - ord('A')
        y = ord(text[i + 1]) - ord('A')

        a = (key[0][0] * x + key[0][1] * y) % 26
        b = (key[1][0] * x + key[1][1] * y) % 26

        result += chr(a + ord('A'))
        result += chr(b + ord('A'))

    return result


def main():
    print("HILL CIPHER ENCRYPTION AND DECRYPTION")

    plaintext = input("Enter plaintext: ").upper()
    key = [[3, 3], [2, 5]]

    print("\nKey Matrix:")
    for row in key:
        print(row)

    encrypted = hill_cipher(plaintext, key)
    print("\nEncrypted Text:", encrypted)

    inverse_key = matrix_inverse(key)
    decrypted = hill_cipher(encrypted, inverse_key)
    print("Decrypted Text:", decrypted)


if __name__ == "__main__":
    main()

